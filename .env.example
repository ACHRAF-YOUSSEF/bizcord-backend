# ── Auth ─────────────────────────────────────────────────────────────────────
# 256-bit key used to sign JWTs (HMAC-SHA-256). Must be Base64-encoded.
# Generate one with: openssl rand -base64 32
APP_JWT_SECRET_KEY=

# ── Cookie ────────────────────────────────────────────────────────────────────
# Set to "false" when running on plain HTTP (http://localhost)
# Set to "true"  when running behind HTTPS in production
APP_COOKIE_SECURE=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origin(s) the browser connects from (comma-separated patterns)
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:8080

# ── Mediasoup ─────────────────────────────────────────────────────────────────
# Shared secret between the backend and mediasoup containers.
# Must match API_SECRET in the mediasoup container.
# Generate one with: openssl rand -base64 32
MEDIASOUP_API_SECRET=

# Public IP of this machine used in WebRTC ICE candidates.
# Use 127.0.0.1 for local testing; set to your real public IP for LAN/internet.
MEDIASOUP_ANNOUNCED_IP=127.0.0.1

# UDP/TCP port range allocated to mediasoup workers for RTC media.
# These ports must be reachable by browser clients (open in firewall/router).
MEDIASOUP_RTC_MIN_PORT=52000
MEDIASOUP_RTC_MAX_PORT=52999

# ── MinIO Object Storage ──────────────────────────────────────────────────────
# Local/dev defaults for the bundled MinIO service.
APP_STORAGE_MINIO_ENDPOINT=http://minio:9000
APP_STORAGE_MINIO_ACCESS_KEY=minioadmin
APP_STORAGE_MINIO_SECRET_KEY=minioadmin
APP_STORAGE_MINIO_BUCKET=bizcord
APP_STORAGE_MINIO_SECURE=false
APP_STORAGE_PUBLIC_BASE_PATH=/api/uploads
